{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["board", "columns", "rows", "ribbon", "surface", "styles", "components", "config.ts", "index.ts", "view.tsx"]
}
