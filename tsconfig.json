{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": [
		"interface",
		"columns",
		"links",
		"geometry",
		"board",
		"index.ts",
		"view.tsx",
		"interface/styled.d.ts"
	]
}
